        "z": "number",
        "dimension": "string"
      },
      "follow_best": "boolean"
    },
    "response_schema": {
      "goal_id": "string",
      "ack": "boolean"
    }
  },
  {
    "name": "goto",
    "category": "pathing",
    "method": "POST",
    "path": "/api/path/goto",
    "description": "Start navigating toward the provided goal immediately.",
