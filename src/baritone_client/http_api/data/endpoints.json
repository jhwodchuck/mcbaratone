    "request_schema": {
      "x": "number",
      "y": "number",
      "z": "number",
      "dimension": "string",
      "allow_break": "boolean",
      "allow_place": "boolean"
    },
    "response_schema": {
      "task_id": "string",
      "state": [
        "submitted",
        "running"
      ]
    }
  },
  {
    "name": "pause",
    "category": "pathing",
    "method": "POST",
    "path": "/api/path/pause",
    "description": "Pause the current pathing task.",
