[
  {
    "name": "login",
    "category": "auth",
    "method": "POST",
    "path": "/api/login",
    "description": "Create a session token for subsequent requests.",
    "auth": "none",
    "request_schema": {
      "username": "string",
      "password": "string"
    },
    "response_schema": {
      "token": "string",
      "expires_in": "integer"
    }
  },
  {
    "name": "logout",
    "category": "auth",
    "method": "POST",
    "path": "/api/logout",
    "description": "Invalidate the current token or session cookie.",
    "auth": "token",
    "request_schema": {},
    "response_schema": {
      "ok": "boolean"
    }
  },
  {
    "name": "session",
    "category": "auth",
    "method": "GET",
    "path": "/api/session",
    "description": "Return metadata about the active session, if any.",
    "auth": "token",
    "request_schema": {},
    "response_schema": {
      "user": "string",
      "expires_at": "string",
      "scopes": [
        "control",
        "settings",
        "status"
      ]
    }
  },
  {
    "name": "health",
    "category": "meta",
    "method": "GET",
    "path": "/api/health",
    "description": "Simple readiness/liveness probe.",
    "auth": "optional",
    "request_schema": {},
    "response_schema": {
      "ok": "boolean",
      "uptime_ms": "integer"
    }
  },
  {
    "name": "status",
    "category": "status",
    "method": "GET",
    "path": "/api/status",
    "description": "Return the active goal, queued tasks, and player position.",
    "auth": "token",
    "request_schema": {},
    "response_schema": {
      "state": [
        "idle",
        "pathing",
        "paused",
        "stuck",
        "cooldown"
      ],
      "position": {
        "x": "number",
        "y": "number",
        "z": "number",
        "dimension": "string"
      },
      "goal": {
        "type": [
          "coordinate",
          "block",
          "follow"
        ],
        "x": "number",
        "y": "number",
        "z": "number",
        "dimension": "string"
      },
      "queued_operations": "array",
      "paused": "boolean"
    }
  },
  {
    "name": "queue",
    "category": "status",
    "method": "GET",
    "path": "/api/queue",
    "description": "Inspect pending task queue and their states.",
    "auth": "token",
    "request_schema": {},
    "response_schema": {
      "current": "object",
      "pending": "array",
      "completed": "array"
    }
  },
  {
    "name": "operations-history",
    "category": "status",
    "method": "GET",
    "path": "/api/operations/history",
    "description": "Recent control operations and timestamps.",
    "auth": "token",
    "request_schema": {},
    "response_schema": {
      "recent": [
        {
          "name": "string",
          "state": [
            "submitted",
            "running",
            "succeeded",
            "failed"
          ],
          "queued_at": "string"
        }
      ]
    }
  },
  {
    "name": "set-goal",
    "category": "pathing",
    "method": "POST",
    "path": "/api/path/goal",
