    "name": "Baritone API Bridge",
    "description": "Bridge for Python control of Baritone",
    "authors": [
        "Baritone Python Client"
    ],
    "contact": {
        "homepage": "https://github.com/cabaletta/baritone",
        "sources": "https://github.com/cabaletta/baritone"
    },
    "license": "LGPL-3.0",
    "icon": "assets/modid/icon.png",
